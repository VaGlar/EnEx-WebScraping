# Σημερινή ( ή χθεσινή) ημερομηνία σε μορφή YYYYMMDD
# today = (datetime.today() - timedelta(days=1)).strftime('%Y%m%d')
today = datetime.today().strftime('%Y%m%d')
target_date = datetime.strptime(today, '%Y%m%d').date()


# Δημιουργία URL για το αρχείο DAM της ημέρας
url = f"https://www.enexgroup.gr/documents/20126/200106/{today}_EL-DAM_Results_EN_v01.xlsx"

# Προσπάθεια λήψης του αρχείου
try:
    response = requests.get(url)
    if response.status_code == 200:
        excel_data = BytesIO(response.content)
        dam_df = pd.read_excel(excel_data, engine="openpyxl")
        print(f"Το αρχείο DAM για την {today} κατέβηκε επιτυχώς και περιέχει {len(dam_df)} γραμμές.")

        # Επεξεργασία δεδομένων
        clean_df = dam_df[['DELIVERY_MTU', 'MCP']].drop_duplicates(subset=['DELIVERY_MTU'])
        clean_df['Ώρα'] = pd.to_datetime(clean_df['DELIVERY_MTU']).dt.hour
        hourly_mcp = clean_df.groupby('Ώρα')['MCP'].mean().reset_index()
        hourly_mcp['Ημερομηνία'] = target_date
        hourly_mcp = hourly_mcp[['Ώρα', 'MCP', 'Ημερομηνία']]


        # Προσθήκη δεδομένων στο Excel
        excel_path ='/content/drive/MyDrive/mcp_2025_full.xlsx'
        wb = load_workbook(excel_path)
        ws = wb["Sheet1"]
        
          # Ανάγνωση υπαρχόντων δεδομένων
        existing_data = []
        for row in ws.iter_rows(min_row=2, values_only=True):
            existing_data.append(row[:3])
        
        existing_df = pd.DataFrame(existing_data, columns=['Ώρα', 'MCP', 'Ημερομηνία'])
        existing_df['Ημερομηνία'] = pd.to_datetime(existing_df['Ημερομηνία'], errors='coerce').dt.date

        # Έλεγχος αν υπάρχει ήδη η ημερομηνία
        if target_date in existing_df['Ημερομηνία'].unique():
            print(f"❌ Οι τιμές MCP για την {target_date} υπάρχουν ήδη στο αρχείο. Δεν έγινε προσθήκη.")
        else:
            for r in dataframe_to_rows(hourly_mcp, index=False, header=False):
                ws.append(r)
            wb.save(excel_path)
            print(f"✅ Οι τιμές MCP για την {target_date} προστέθηκαν επιτυχώς στο αρχείο.")
    else:
        print(f"❌ Το αρχείο DAM για την {today} δεν είναι διαθέσιμο (status code {response.status_code}).")
except Exception as e:
    print(f"❌ Σφάλμα κατά τη λήψη ή επεξεργασία του αρχείου DAM για την {today}: {e}")
